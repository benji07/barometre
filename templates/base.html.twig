<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">

    <title>{% block title 'Baromètre AFUP' %}</title>

    {% include 'favicons.html' %}
    {% include 'tarteaucitron.twig' %}

    {% block meta %}
        <meta name="description" content="{% block meta_description '' %}">
        <meta name="viewport" content="width=device-width">
        <meta property="og:image" content="{{ asset('logos/og-image.png') }}" />
    {% endblock meta %}

    {% block stylesheets %}
        {# CSS compilé par SassBundle #}
        <link rel="stylesheet" href="{{ asset('styles/app.scss') }}" />
        {# Font Awesome via CDN #}
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" integrity="sha512-SfTiTlXpbJ0zJgO2HqD8B28T4N7M8JQkbxFHpPe5LKFAggYtXtLSohQg0OUHB+wSH8G3T4S5DBzWBvyF4x8C0w==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    {% endblock stylesheets %}
    <link rel="stylesheet" href="{{ global_menu_prefix }}/templates/site/css/global-menu.css" media="all" />
    {% block ga '' %}
</head>
<body>
<div id="afup-global-menu">
    <a href="https://afup.org" class="lien-entete">AFUP</a>
    <a href="https://event.afup.org" class="lien-entete">{{ app.request.server.get('AFUP_GLOBAL_MENU_EVENT_LABEL') }}</a>
    <a href="https://barometre.afup.org" class="lien-entete lien-entete__active">Baromètre</a>
    <a href="http://www.planete-php.fr" class="lien-entete">Planète PHP</a>
    <a href="https://pufa.afup.org" class="lien-entete">PUFA</a>
</div>
{% block body '' %}
{% block body_javascript %}
    {# Librairies legacy (ordre important) - D3 v7 est chargé via importmap #}
    <script src="{{ asset('vendor/jquery-3.7.1.min.js') }}"></script>
    <script src="{{ asset('vendor/bootstrap3/transition.js') }}"></script>
    <script src="{{ asset('vendor/bootstrap3/dropdown.js') }}"></script>
    <script src="{{ asset('vendor/bootstrap3/collapse.js') }}"></script>
    <script src="{{ asset('vendor/highcharts.js') }}"></script>
    <script src="{{ asset('vendor/highchartTable.min.js') }}"></script>
    <script src="{{ asset('vendor/select2/select2.min.js') }}"></script>
    <script src="{{ asset('vendor/select2/fr.js') }}"></script>
    <script src="{{ asset('vendor/tablesorter/jquery.tablesorter.min.js') }}"></script>
    <script src="{{ asset('vendor/tablesorter/jquery.tablesorter.widgets.min.js') }}"></script>

    {# AssetMapper - D3 v7 + scripts custom #}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
{% endblock body_javascript %}
{% include 'github_ribbon.twig' %}
</body>
</html>
